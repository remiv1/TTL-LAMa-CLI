FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    XDG_CONFIG_HOME=/tmp/ttlama-cli-config

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        wireguard-tools \
        iproute2 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/ttlama-cli

COPY pyproject.toml ./
COPY src/ ./src/
COPY tests/ ./tests/

RUN python -m pip install --no-cache-dir '.[test]'

CMD ["python", "-m", "pytest", "-q", "tests/integration"]