FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    XDG_CONFIG_HOME=/tmp/ttlama-cli-config

WORKDIR /opt/ttlama-cli

RUN useradd -m test-user

COPY pyproject.toml ./
COPY src/ ./src/
COPY tests/ ./tests/

RUN python -m pip install --no-cache-dir '.[test]'

USER test-user

CMD ["python", "-m", "pytest", "-q", "tests/integration"]